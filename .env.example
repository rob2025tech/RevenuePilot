# RevenuePilot – Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Snowflake (Data warehouse)
# ---------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=REVENUE_PILOT
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=                      # optional; omit to use the account default

# ---------------------------------------------------------------------------
# Cortex Analyst (optional live data layer)
# ---------------------------------------------------------------------------
# When STAGE + SEMANTIC_MODEL_FILE are set AND the connection values above are
# present, DataAgent tries the live Cortex Analyst path first. If anything is
# missing (or the live request fails) it falls back to deterministic mock data.
#
# The semantic model is NOT provisioned by RevenuePilot. Stage it manually, e.g.:
#   CREATE STAGE REVENUE_PILOT.PUBLIC.CORTEX_SEMANTIC_MODEL;
#   PUT file://semantic_model/revenue_risk.yaml \
#       @REVENUE_PILOT.PUBLIC.CORTEX_SEMANTIC_MODEL AUTO_COMPRESS=FALSE OVERWRITE=TRUE;
# The resolved REST reference becomes:
#   @<DATABASE>.<SCHEMA>.<STAGE>/<FILE>  ->  @REVENUE_PILOT.PUBLIC.CORTEX_SEMANTIC_MODEL/revenue_risk.yaml
SNOWFLAKE_STAGE=CORTEX_SEMANTIC_MODEL
CORTEX_SEMANTIC_MODEL_FILE=revenue_risk.yaml
CORTEX_ANALYST_QUESTION=             # optional override of the default NL question

# ---------------------------------------------------------------------------
# Composio (Gmail / Slack / CRM integrations)
# ---------------------------------------------------------------------------
COMPOSIO_API_KEY=your_composio_api_key

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
DEBUG=false

# Risk engine overrides (optional)
APPROVAL_THRESHOLD_AMOUNT=10000  # Strategies above this $ require human approval
HIGH_RISK_SCORE_THRESHOLD=0.7    # Score above which an account is flagged HIGH
